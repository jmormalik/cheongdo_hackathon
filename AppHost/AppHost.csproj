<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.4" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.6.4" />
  </ItemGroup>
</Project>
